{
  "name": "sportshub",
  "version": "1.3.0",
  "description": "Backend finto per la modalita' locale dell'autenticazione",
  "private": true,
  "scripts": {
    "server:init": "node -e \"require('fs').copyFileSync('db.example.json','db.json')\"",
    "server": "json-server-auth db.json --host 127.0.0.1 --port 3001"
  },
  "devDependencies": {
    "json-server": "0.17.4",
    "json-server-auth": "2.1.0"
  }
}
